{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctdd-resume.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctdd-resume.py\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
